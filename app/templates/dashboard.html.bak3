<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="{{ csrf_token() }}">
<title>Kemet AI — Dashboard</title>

<style>
:root{
--bg:#07111f;--panel:#0d1a2b;--border:rgba(255,255,255,.08);
--text:#f4f7fb;--muted:#8fa2b8;--primary:#6d5dfc;
--cyan:#19c8ff;--green:#28d17c;--red:#ff5d73;
}

*{box-sizing:border-box}

body{
margin:0;
background:
radial-gradient(circle at 80% 0%,rgba(109,93,252,.15),transparent 30%),
radial-gradient(circle at 10% 20%,rgba(25,200,255,.08),transparent 25%),
var(--bg);
color:var(--text);
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
}

a{color:inherit;text-decoration:none}

.layout{display:flex;min-height:100vh}

.main{
flex:1;
min-width:0;
padding:28px
}

.topbar{
display:flex;
align-items:center;
justify-content:space-between;
gap:20px;
margin-bottom:28px
}

.title h1{
margin:0;
font-size:30px;
letter-spacing:-.7px
}

.title p{
margin:7px 0 0;
color:var(--muted);
font-size:14px
}

.status{
display:flex;
align-items:center;
gap:9px;
padding:10px 15px;
border:1px solid var(--border);
background:rgba(255,255,255,.035);
border-radius:30px;
color:#b9c8d8;
font-size:13px
}

.dot{
width:9px;
height:9px;
border-radius:50%;
background:var(--green);
box-shadow:0 0 15px rgba(40,209,124,.8)
}

.hero{
position:relative;
overflow:hidden;
border:1px solid rgba(109,93,252,.22);
border-radius:24px;
padding:28px;
margin-bottom:22px;
background:
linear-gradient(135deg,rgba(109,93,252,.20),rgba(25,200,255,.06)),
var(--panel);
box-shadow:0 20px 60px rgba(0,0,0,.25)
}

.hero-content{position:relative;z-index:2}

.badge{
display:inline-flex;
padding:6px 11px;
border-radius:20px;
background:rgba(40,209,124,.10);
color:#6ff0aa;
border:1px solid rgba(40,209,124,.18);
font-size:12px;
font-weight:700;
margin-bottom:13px
}

.hero h2{
margin:0;
font-size:27px
}

.hero p{
color:#a9b9ca;
line-height:1.7;
margin:10px 0 20px
}

.actions{
display:flex;
flex-wrap:wrap;
gap:10px
}

.btn{
display:inline-flex;
align-items:center;
gap:8px;
padding:11px 16px;
border-radius:12px;
border:1px solid var(--border);
background:rgba(255,255,255,.05);
font-size:13px;
font-weight:700;
transition:.2s
}

.btn:hover{
transform:translateY(-2px);
background:rgba(255,255,255,.09)
}

.btn.primary{
background:linear-gradient(135deg,#6d5dfc,#5143df);
border-color:transparent
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px;
margin-bottom:22px
}

.card{
border:1px solid var(--border);
background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.018));
border-radius:18px;
padding:19px;
min-width:0
}

.card-head{
display:flex;
justify-content:space-between;
align-items:center;
color:var(--muted);
font-size:12px
}

.icon{
width:38px;
height:38px;
border-radius:11px;
display:flex;
align-items:center;
justify-content:center;
background:rgba(109,93,252,.13);
font-size:19px
}

.value{
margin-top:17px;
font-size:28px;
font-weight:800
}

.sub{
margin-top:6px;
color:var(--muted);
font-size:12px
}

.content-grid{
display:grid;
grid-template-columns:1.45fr .85fr;
gap:18px
}

.panel{
border:1px solid var(--border);
background:rgba(13,26,43,.82);
border-radius:20px;
padding:21px;
min-width:0
}

.panel-title{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px
}

.panel-title h3{
margin:0;
font-size:16px
}

.panel-title span{
color:var(--muted);
font-size:12px
}

.usage-row{
display:flex;
justify-content:space-between;
font-size:13px;
margin-bottom:9px
}

.progress{
width:100%;
height:10px;
border-radius:20px;
overflow:hidden;
background:rgba(255,255,255,.07)
}

.progress span{
display:block;
height:100%;
border-radius:20px;
background:linear-gradient(90deg,var(--primary),var(--cyan))
}

.quick{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px
}

.quick a{
padding:15px;
border-radius:14px;
border:1px solid var(--border);
background:rgba(255,255,255,.025);
transition:.2s
}

.quick a:hover{
border-color:rgba(109,93,252,.45);
background:rgba(109,93,252,.08);
transform:translateY(-2px)
}

.quick strong{
display:block;
margin-bottom:5px;
font-size:13px
}

.quick small{
color:var(--muted);
font-size:11px
}

.activity{
display:flex;
flex-direction:column;
gap:13px
}

.activity-item{
display:flex;
align-items:center;
gap:12px;
padding-bottom:13px;
border-bottom:1px solid var(--border)
}

.activity-item:last-child{
border-bottom:0;
padding-bottom:0
}

.activity-icon{
width:34px;
height:34px;
flex-shrink:0;
border-radius:10px;
display:flex;
align-items:center;
justify-content:center;
background:rgba(25,200,255,.08)
}

.activity-text strong{
display:block;
font-size:12px
}

.activity-text small{
color:var(--muted);
font-size:11px
}

.plan{
display:flex;
align-items:center;
justify-content:space-between;
padding:15px;
border-radius:15px;
background:linear-gradient(135deg,rgba(109,93,252,.14),rgba(25,200,255,.06));
border:1px solid rgba(109,93,252,.18);
margin-bottom:16px
}

.plan-name{
font-size:17px;
font-weight:800
}

.plan small{
display:block;
margin-top:4px;
color:var(--muted)
}

.upgrade{
color:#fff;
background:var(--primary);
padding:8px 11px;
border-radius:9px;
font-size:11px;
font-weight:700
}

.footer-note{
margin-top:22px;
text-align:center;
color:#65788e;
font-size:11px
}

@media(max-width:1100px){
.cards{grid-template-columns:repeat(2,1fr)}
.content-grid{grid-template-columns:1fr}
}

@media(max-width:700px){
.main{
margin-left:72px;
width:calc(100% - 72px);
padding:15px
}

.topbar{align-items:flex-start}

.title h1{font-size:23px}

.status{
padding:8px 10px;
font-size:11px
}

.hero{
padding:21px;
border-radius:19px
}

.hero h2{font-size:22px}

.cards{grid-template-columns:1fr}

.quick{grid-template-columns:1fr}

.actions .btn{
flex:1;
justify-content:center
}
}
</style>
</head>

<body>

<div class="layout">

{% include "partials/sidebar.html" %}

<main class="main">

<div class="topbar">
<div class="title">
<h1>Dashboard</h1>
<p>Your Kemet AI command center</p>
</div>

<div class="status">
<span class="dot"></span>
All systems operational
</div>
</div>

<section class="hero">
<div class="hero-content">

<span class="badge">✦ KEMET AI ACTIVE</span>

<h2>
Welcome back{% if current_user.is_authenticated %}
{{ ", " + (current_user.name or current_user.username or current_user.email)|truncate(25,True,"") }}
{% endif %}
</h2>

<p>
Manage your AI conversations, support tickets, documents
and subscription from one intelligent workspace.
</p>

<div class="actions">

<a class="btn primary" href="{{ url_for('main.chat_page') }}">
🤖 Start AI Chat
</a>

<a class="btn" href="{{ url_for('tickets.create_ticket') }}">
🎫 New Ticket
</a>

<a class="btn" href="{{ url_for('upload.upload') }}">
📄 Upload
</a>

</div>
</div>
</section>

<section class="cards">

<div class="card">
<div class="card-head">
<span>AI USAGE</span>
<div class="icon">🤖</div>
</div>
<div class="value">{{ ai_used|default(0) }}</div>
<div class="sub">{{ ai_remaining|default(0) }} requests remaining</div>
</div>

<div class="card">
<div class="card-head">
<span>SUPPORT</span>
<div class="icon">🎫</div>
</div>
<div class="value">{{ open_tickets|default(0) }}</div>
<div class="sub">Open support tickets</div>
</div>

<div class="card">
<div class="card-head">
<span>DOCUMENTS</span>
<div class="icon">📚</div>
</div>
<div class="value">{{ document_count|default(0) }}</div>
<div class="sub">Knowledge documents</div>
</div>

<div class="card">
<div class="card-head">
<span>PLAN</span>
<div class="icon">💎</div>
</div>
<div class="value" style="font-size:21px">
{{ plan_name|default("Free")|capitalize }}
</div>
<div class="sub">Current subscription</div>
</div>

</section>

<section class="content-grid">

<div>

<div class="panel">

<div class="panel-title">
<h3>AI Usage</h3>
<span>{{ ai_used|default(0) }} / {{ ai_limit|default(100) }}</span>
</div>

<div class="usage-row">
<span>Monthly AI consumption</span>
<strong>{{ usage_percent|default(0) }}%</strong>
</div>

<div class="progress">
<span style="width:{{ usage_percent|default(0) }}%"></span>
</div>

</div>

<div class="panel" style="margin-top:18px">

<div class="panel-title">
<h3>Recent Activity</h3>
<span>Latest</span>
</div>

<div class="activity">

<div class="activity-item">
<div class="activity-icon">🤖</div>
<div class="activity-text">
<strong>AI Assistant Ready</strong>
<small>Your AI workspace is available</small>
</div>
</div>

<div class="activity-item">
<div class="activity-icon">🎫</div>
<div class="activity-text">
<strong>Support Center</strong>
<small>Manage your support requests</small>
</div>
</div>

<div class="activity-item">
<div class="activity-icon">📄</div>
<div class="activity-text">
<strong>Knowledge Base</strong>
<small>Upload documents to enhance AI answers</small>
</div>
</div>

</div>
</div>

</div>

<div>

<div class="panel">

<div class="panel-title">
<h3>Your Plan</h3>
<span>Subscription</span>
</div>

<div class="plan">
<div>
<div class="plan-name">
{{ plan_name|default("Free")|capitalize }}
</div>
<small>{{ ai_limit|default(100) }} AI requests</small>
</div>

<a class="upgrade" href="{{ url_for('main.pricing') }}">
Upgrade
</a>
</div>

<div class="panel-title">
<h3>Quick Actions</h3>
</div>

<div class="quick">

<a href="{{ url_for('main.chat_page') }}">
<strong>🤖 AI Chat</strong>
<small>Talk to Kemet AI</small>
</a>

<a href="{{ url_for('conversations.list_conversations') }}">
<strong>💬 Conversations</strong>
<small>View your history</small>
</a>

<a href="{{ url_for('tickets.list_tickets') }}">
<strong>🎫 Tickets</strong>
<small>Get support</small>
</a>

<a href="{{ url_for('settings.settings') }}">
<strong>⚙️ Settings</strong>
<small>Configure your account</small>
</a>

</div>

</div>

</div>

</section>

<div class="footer-note">
Kemet AI · Intelligent Customer Support Platform
</div>

</main>
</div>

<script>
async function checkHealth(){
try{
const r=await fetch("/api/health",{credentials:"same-origin"});
if(!r.ok)throw new Error();

document.querySelector(".status").innerHTML=
'<span class="dot"></span> All systems operational';
}catch(e){
document.querySelector(".status").innerHTML=
'<span class="dot" style="background:#ff5d73"></span> System check failed';
}
}

checkHealth();
</script>

</body>
</html>
