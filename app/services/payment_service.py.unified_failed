import os
from decimal import Decimal

import requests

from app import db
from app.models.payment import Payment
from app.models.subscription import Subscription
from app.services.exchange_rate_service import convert_usd_to_egp


PLAN_PRICES = {
    "starter": Decimal("9.00"),
    "business": Decimal("29.00"),
    "enterprise": Decimal("79.00"),
}

PAYMOB_API_URL = "https://accept.paymob.com/v1/intention/"
PAYMOB_CHECKOUT_URL = "https://accept.paymob.com/unifiedcheckout/"


def get_plan_price(plan):
    return PLAN_PRICES.get((plan or "").lower())


def get_paymob_integration_id():
    value = os.getenv("PAYMOB_INTEGRATION_ID", "").strip()

    if not value:
        raise RuntimeError(
            "PAYMOB_INTEGRATION_ID is missing"
        )

    try:
        integration_id = int(value)
    except ValueError as exc:
        raise RuntimeError(
            "PAYMOB_INTEGRATION_ID must be numeric"
        ) from exc

    if integration_id <= 0:
        raise RuntimeError(
            "PAYMOB_INTEGRATION_ID must be greater than zero"
        )

    return integration_id


def paymob_configured():
    required = [
        "PAYMOB_API_KEY",
        "PAYMOB_SECRET_KEY",
        "PAYMOB_PUBLIC_KEY",
        "PAYMOB_INTEGRATION_ID",
    ]

    return all(os.getenv(name, "").strip() for name in required)


def create_checkout(organization_id, plan):
    plan = (plan or "").lower()

    if plan not in PLAN_PRICES:
        raise ValueError("Invalid plan")

    price = get_plan_price(plan)

    if price is None:
        return {
            "status": "contact_sales",
            "plan": plan,
            "price": None,
        }

    fx = convert_usd_to_egp(price)
    egp_price = fx["egp"]

    if os.getenv("PAYMENT_MODE", "mock").lower() == "mock":
        payment = Payment(
            organization_id=organization_id,
            plan=plan,
            amount=egp_price,
            currency="EGP",
            status="pending",
            provider="mock",
        )
        db.session.add(payment)
        db.session.commit()

        return {
            "status": "mock",
            "payment_id": payment.id,
            "plan": plan,
            "price": str(price),
            "price_usd": str(price),
            "price_egp": str(egp_price),
            "currency": "EGP",
            "exchange_rate": str(fx["rate"]),
            "exchange_rate_source": fx["source"],
            "exchange_rate_date": fx["provider_date"],
            "exchange_rate_fallback": fx["fallback"],
            "checkout_url": f"/payment/mock/{payment.id}",
        }

    if not paymob_configured():
        raise RuntimeError("Paymob is not configured")

    integration_id = get_paymob_integration_id()

    secret_key = os.getenv("PAYMOB_SECRET_KEY", "").strip()
    public_key = os.getenv("PAYMOB_PUBLIC_KEY", "").strip()

    if not secret_key:
        raise RuntimeError("PAYMOB_SECRET_KEY is missing")

    if not public_key:
        raise RuntimeError("PAYMOB_PUBLIC_KEY is missing")

    payment = Payment(
        organization_id=organization_id,
        plan=plan,
        amount=egp_price,
        currency="EGP",
        status="pending",
        provider="paymob",
    )

    db.session.add(payment)
    db.session.flush()

    amount_cents = int(egp_price * 100)

    payload = {
        "amount": amount_cents,
        "currency": "EGP",
        "payment_methods": [integration_id],
        "items": [
            {
                "name": f"Kemet AI {plan.capitalize()}",
                "amount": amount_cents,
                "description": f"Kemet AI {plan} subscription",
                "quantity": 1,
            }
        ],
        "billing_data": {
            "apartment": "NA",
            "email": "customer@example.com",
            "floor": "NA",
            "first_name": "Kemet",
            "street": "NA",
            "building": "NA",
            "phone_number": "NA",
            "shipping_method": "NA",
            "postal_code": "NA",
            "city": "Cairo",
            "country": "EG",
            "last_name": "AI",
            "state": "Cairo",
        },
        "customer": {
            "first_name": "Kemet",
            "last_name": "AI",
            "email": "customer@example.com",
        },
        "extras": {
            "organization_id": organization_id,
            "plan": plan,
            "payment_id": payment.id,
        },
    }

    try:
        response = requests.post(
            PAYMOB_API_URL,
            headers={
                "Authorization": f"Token {secret_key}",
                "Content-Type": "application/json",
            },
            json=payload,
            timeout=30,
        )

        if response.status_code not in (200, 201):
            raise RuntimeError(
                f"Paymob intention failed ({response.status_code}): "
                f"{response.text[:1000]}"
            )

        data = response.json()
        client_secret = data.get("client_secret")

        if not client_secret:
            raise RuntimeError(
                "Paymob did not return client_secret: "
                f"{response.text[:1000]}"
            )

    except requests.RequestException as exc:
        db.session.rollback()
        raise RuntimeError(
            f"Paymob connection failed: {exc}"
        ) from exc
    except Exception:
        db.session.rollback()
        raise

    payment.checkout_id = str(data.get("id") or payment.id)
    payment.client_secret = client_secret

    checkout_url = (
        f"{PAYMOB_CHECKOUT_URL}"
        f"?publicKey={public_key}"
        f"&clientSecret={client_secret}"
    )

    db.session.commit()

    return {
        "status": "ready",
        "plan": plan,
        "price": price,
        "price_usd": price,
        "price_egp": egp_price,
        "currency": "EGP",
        "exchange_rate": fx["rate"],
        "exchange_rate_source": fx["source"],
        "exchange_rate_date": fx["provider_date"],
        "exchange_rate_fallback": fx["fallback"],
        "organization_id": organization_id,
        "payment_id": payment.id,
        "checkout_id": payment.checkout_id,
        "client_secret": client_secret,
        "checkout_url": checkout_url,
    }


def activate_subscription(organization_id, plan):
    plan = (plan or "").lower()

    if plan not in PLAN_PRICES:
        raise ValueError("Invalid plan")

    subscription = Subscription.query.filter_by(
        organization_id=organization_id
    ).first()

    if not subscription:
        raise ValueError("Subscription not found")

    subscription.plan = plan
    subscription.status = "active"

    db.session.commit()

    return subscription
